# Browser build path. Use / for a root deployment or /protocol/ for a subpath.
VITE_BASE_PATH=/

# Public GA4 identifier. Analytics loads only after visitor consent.
VITE_GA_MEASUREMENT_ID=G-2ZWLL7P02J

# Express listener.
PORT=4173

# Persistent Theme Workshop data. Keep these paths outside the source tree in
# production or mount a persistent volume at the containing directory.
PATH_PROTOCOL_DATA_DIR=./data/themes
PATH_PROTOCOL_DB_PATH=./data/path-protocol.sqlite
PATH_PROTOCOL_PERSONAL_MEDIA_ROOT=./data/user-media

# Set to 1 whenever the production site is served over HTTPS.
PATH_PROTOCOL_SECURE_COOKIES=0

# Optional public-media source location and upload limits.
PATH_PROTOCOL_MEDIA_LIBRARY_ROOT=./PublicMedia
PATH_PROTOCOL_ACCOUNT_MEDIA_QUOTA_BYTES=524288000
PATH_PROTOCOL_MAX_UPLOAD_IMAGE_BYTES=26214400
PATH_PROTOCOL_MAX_UPLOAD_AUDIO_BYTES=104857600
PATH_PROTOCOL_MAX_UPLOAD_IMAGE_DIMENSION=4096
PATH_PROTOCOL_MAX_UPLOAD_IMAGE_PIXELS=16777216
PATH_PROTOCOL_MAX_UPLOAD_AUDIO_SECONDS=300
