{
  "name": "path-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run docs:build && npm run config:validate && npm run media:prepare",
    "dev": "concurrently --kill-others-on-fail --names frontend,server --prefix-colors cyan,magenta \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "vite",
    "dev:server": "node --watch server/index.js",
    "prebuild": "npm run docs:build && npm run config:validate && npm run media:prepare",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "media:validate-svg": "node scripts/validate-svg-media.mjs",
    "media:wav:defaults": "node scripts/generate-default-wav.mjs",
    "media:audio": "node scripts/convert-audio.mjs",
    "media:audio:force": "node scripts/convert-audio.mjs --force",
    "media:validate-audio": "node scripts/validate-audio-media.mjs",
    "media:manifests": "node scripts/build-media-manifests.mjs",
    "media:3d-manifest": "node scripts/build-3d-manifest.mjs",
    "media:3d-manifest:check": "node scripts/build-3d-manifest.mjs --check",
    "media:prepare": "npm run media:wav:defaults && npm run media:audio && npm run media:validate-svg && npm run media:validate-audio && npm run media:manifests && npm run media:3d-manifest && npm run media:validate-themes",
    "media:validate-themes": "node scripts/validate-themes.mjs",
    "config:validate": "vitest run src/config/validateConfig.test.js src/config/loadConfig.test.js",
    "preview": "node server/index.js",
    "start": "node server/index.js",
    "server:test": "vitest run server/themeApi.test.js",
    "lint": "eslint . && npm run docs:validate",
    "docs:build": "node scripts/build-designer-help.mjs",
    "docs:validate": "node scripts/build-designer-help.mjs --check && node scripts/validate-jsdoc.mjs && npm run media:3d-manifest:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs --project=chromium",
    "test:browser-compat": "npm run build && node scripts/run-e2e.mjs tests/e2e/browser-compat.spec.js --project=chromium --project=edge"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.2.0",
    "busboy": "^1.6.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "howler": "2.2.4",
    "pixi.js": "8.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.179.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "marked": "^18.0.7",
    "supertest": "^7.1.4",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
