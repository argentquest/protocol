{
  "name": "path-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run config:validate && npm run media:prepare",
    "dev": "vite",
    "prebuild": "npm run config:validate && npm run media:prepare",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "media:validate-svg": "node scripts/validate-svg-media.mjs",
    "media:wav:defaults": "node scripts/generate-default-wav.mjs",
    "media:audio": "node scripts/convert-audio.mjs",
    "media:audio:force": "node scripts/convert-audio.mjs --force",
    "media:validate-audio": "node scripts/validate-audio-media.mjs",
    "media:manifests": "node scripts/build-media-manifests.mjs",
    "media:prepare": "npm run media:wav:defaults && npm run media:audio && npm run media:validate-svg && npm run media:validate-audio && npm run media:manifests",
    "config:validate": "vitest run src/config/validateConfig.test.js src/config/loadConfig.test.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs --project=chromium",
    "test:browser-compat": "npm run build && node scripts/run-e2e.mjs tests/e2e/browser-compat.spec.js --project=chromium --project=edge"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "howler": "2.2.4",
    "pixi.js": "8.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "ffmpeg-static": "^5.3.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
