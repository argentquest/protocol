{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "path-protocol-level.schema.json",
  "title": "Path Protocol level",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "number",
    "name",
    "seed",
    "arena",
    "token",
    "start",
    "mainTarget",
    "generation",
    "scoring",
    "bonuses"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^level-[0-9]{2}$" },
    "number": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "seed": { "type": "string", "minLength": 1 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 10 },
    "briefing": { "type": "string" },
    "arena": { "type": "object" },
    "token": { "type": "object" },
    "start": { "type": "object" },
    "mainTarget": { "type": "object" },
    "generation": { "type": "object" },
    "manualObstacles": { "type": "array" },
    "movingObstacles": { "type": "array" },
    "trackingObstacles": { "type": "array" },
    "coins": { "type": "array" },
    "rewards": { "type": "object" },
    "scoring": { "type": "object" },
    "bonuses": { "type": "object" }
  },
  "additionalProperties": false
}
