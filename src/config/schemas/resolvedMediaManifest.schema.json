{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://path-protocol.local/schemas/resolvedMediaManifest.schema.json",
  "title": "Path Protocol resolved theme manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mediaVersion", "theme", "pixi", "visuals", "audio"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mediaVersion": { "type": "integer", "minimum": 1 },
    "theme": { "type": "string", "pattern": "^(default|[a-z0-9]+(?:-[a-z0-9]+)*)$" },
    "pixi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundles"],
      "properties": {
        "bundles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "assets"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "assets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["alias", "src"],
                  "properties": {
                    "alias": { "type": "string", "minLength": 1 },
                    "src": { "type": "string", "pattern": "\\.(?:png|svg)\\?v=[0-9]+$" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "visuals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mediaId",
          "alias",
          "src",
          "category",
          "renderMode",
          "sizing",
          "sourceScope"
        ],
        "properties": {
          "mediaId": { "type": "string", "minLength": 1 },
          "alias": { "type": "string", "minLength": 1 },
          "src": { "type": "string", "pattern": "\\.(?:png|svg)\\?v=[0-9]+$" },
          "category": { "type": "string", "minLength": 1 },
          "renderMode": { "enum": ["texture", "vector"] },
          "sizing": { "enum": ["contain", "stretch"] },
          "sourceScope": { "enum": ["default", "theme"] }
        }
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "soundId",
          "sources",
          "settings",
          "fileSourceScope",
          "settingsSourceScope"
        ],
        "properties": {
          "soundId": { "type": "string", "minLength": 1 },
          "sources": {
            "type": "array",
            "prefixItems": [
              { "type": "string", "pattern": "\\.webm\\?v=[0-9]+$" },
              { "type": "string", "pattern": "\\.mp3\\?v=[0-9]+$" }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "required": ["volume", "cooldownMs", "loop", "fadeInMs", "fadeOutMs", "channel"],
            "properties": {
              "volume": { "type": "number", "minimum": 0, "maximum": 1 },
              "cooldownMs": { "type": "integer", "minimum": 0 },
              "loop": { "type": "boolean" },
              "fadeInMs": { "type": "integer", "minimum": 0 },
              "fadeOutMs": { "type": "integer", "minimum": 0 },
              "channel": { "enum": ["ambience", "effects"] }
            }
          },
          "fileSourceScope": { "enum": ["default", "theme"] },
          "settingsSourceScope": { "enum": ["default", "theme"] }
        }
      }
    }
  }
}
