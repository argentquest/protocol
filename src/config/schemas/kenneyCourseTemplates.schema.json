{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://path-protocol.local/schemas/kenneyCourseTemplates.schema.json",
  "title": "Path Protocol Kenney course-builder templates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "description", "kind", "model3dId",
          "width", "height", "visualHeight"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["lane", "ramp", "obstacle"] },
          "model3dId": {
            "type": "string",
            "pattern": "^kenney-minigolf-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "width": { "type": "number", "minimum": 10, "maximum": 1600 },
          "height": { "type": "number", "minimum": 10, "maximum": 900 },
          "visualHeight": { "type": "number", "minimum": 10, "maximum": 1600 },
          "wallThickness": { "type": "number", "minimum": 0, "maximum": 200 }
        }
      }
    }
  }
}
