{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://path-protocol.local/schemas/gameConfig.schema.json",
  "title": "Path Protocol V2 game configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "world", "simulation", "input", "collision", "kineticShot"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 1600 },
        "height": { "const": 900 }
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixedStepHz", "maximumFrameDeltaMs"],
      "properties": {
        "fixedStepHz": { "const": 60 },
        "maximumFrameDeltaMs": { "type": "integer", "minimum": 17, "maximum": 1000 }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointerResponsePerSecond", "keyboardSpeedUnitsPerSecond"],
      "properties": {
        "pointerResponsePerSecond": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "keyboardSpeedUnitsPerSecond": {
          "type": "number",
          "minimum": 50,
          "maximum": 2000
        }
      }
    },
    "collision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenToleranceUnits"],
      "properties": {
        "tokenToleranceUnits": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "kineticShot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputStyle", "minimumAimDistance",
        "minimumLaunchSpeed", "maximumLaunchSpeed",
        "aimDistanceForMaximumSpeed", "dragPerSecond", "stopSpeed",
        "restitution", "maximumImpactsPerStep"
      ],
      "properties": {
        "inputStyle": { "enum": ["drag-release", "two-click"] },
        "minimumAimDistance": { "type": "number", "minimum": 0, "maximum": 200 },
        "minimumLaunchSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "maximumLaunchSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "aimDistanceForMaximumSpeed": { "type": "number", "exclusiveMinimum": 0, "maximum": 1600 },
        "dragPerSecond": { "type": "number", "exclusiveMinimum": 0, "maximum": 5000 },
        "stopSpeed": { "type": "number", "minimum": 1, "maximum": 500 },
        "restitution": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "maximumImpactsPerStep": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    }
  }
}
