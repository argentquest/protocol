{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://path-protocol.local/schemas/soundRegistry.schema.json",
  "title": "Path Protocol sound registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sounds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["soundId", "fileName", "channel", "required"],
        "properties": {
          "soundId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "fileName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "channel": { "enum": ["ambience", "effects"] },
          "required": { "type": "boolean" }
        }
      }
    }
  }
}
