{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "path-protocol-powerup.schema.json",
  "title": "Path Protocol power-up catalog",
  "type": "object",
  "required": ["schemaVersion", "powerups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "powerups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "key",
          "description",
          "unlockScore",
          "coinCost",
          "durationMs",
          "effect",
          "sound",
          "color"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "pattern": "^[1-9]$" },
          "description": { "type": "string", "minLength": 1 },
          "unlockScore": { "type": "integer", "minimum": 0 },
          "coinCost": { "type": "integer", "minimum": 1 },
          "durationMs": { "type": "integer", "minimum": 1 },
          "effect": {
            "enum": [
              "obstacleShield",
              "fullShield",
              "slowField",
              "coinMagnet",
              "routeScan"
            ]
          },
          "slowMultiplier": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "radius": { "type": "number", "exclusiveMinimum": 0 },
          "sound": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
